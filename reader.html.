
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Baca Manga</title>
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #111;
      color: white;
      font-family: Arial, sans-serif;
    }

    header {
      padding: 16px;
      background: #202020;
      position: sticky;
      top: 0;
    }

    a {
      color: #7dd3fc;
      text-decoration: none;
    }

    .info {
      padding: 16px;
      text-align: center;
    }

    .pages {
      max-width: 800px;
      margin: auto;
      text-align: center;
    }

    .pages img {
      display: block;
      width: 100%;
      height: auto;
    }

    .notice {
      padding: 30px 16px;
      color: #ccc;
      text-align: center;
    }
  </style>
</head>
<body>
  <header>
    <a href="./index.html">← Kembali ke katalog</a>
  </header>

  <div class="info">
    <h2 id="mangaTitle">Memuat manga...</h2>
    <p id="chapterTitle"></p>
  </div>

  <main class="pages" id="pages"></main>

  <script>
    const params = new URLSearchParams(window.location.search);
    const title = params.get("title") || "Manga";
    const chapter = params.get("chapter") || "1";

    document.getElementById("mangaTitle").textContent = title;
    document.getElementById("chapterTitle").textContent =
      "Chapter " + chapter;

    document.getElementById("pages").innerHTML = `
      <div class="notice">
        <h3>Halaman pembaca siap!</h3>
        <p>Berikutnya kita akan memasukkan gambar halaman manga di sini.</p>
      </div>
    `;

    document.title = title + " - Chapter " + chapter;
  </script>
</body>
</html>
